    "cross-env": "^10.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-module-scripts": "^5.0.7",
    "jscodeshift": "^0.15.2",
    "typescript": "~5.9.2",
    
    "detox": "^20.13.0",
