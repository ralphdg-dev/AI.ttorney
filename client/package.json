    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "gluestack": "^0.1.1",
    "lucide-react-native": "^0.536.0",
    "nativewind": "^4.1.23",
