{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none';"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico",
      "headers": {
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none';"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json",
      "headers": {
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none';"
      }
    },
    {
      "src": "/logo(.*)",
      "dest": "/logo$1",
      "headers": {
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none';"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none';"
      }
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://ai-ttorney-admin-server.onrender.com/api"
  }
}
